Options -Indexes

RewriteEngine On
RewriteRule ^docs(?:/|$) - [F,L,NC]
RewriteRule ^adicionales-por-aprobar/propuesta-(?:roberto|equipo-internacional)(?:/.*)?$ https://kunsanggar.com/propuesta-internacional/ [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^(?:www\.)?kunsanggarmexico\.com$ [NC]
RewriteRule ^ https://kunsanggar.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.kunsanggar\.com$ [NC]
RewriteRule ^ https://kunsanggar.com%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_authz_core.c>
  <FilesMatch "^(books\.html|plan-12000\.html|plan-18000\.html)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(books\.html|plan-12000\.html|plan-18000\.html)$">
    Deny from all
  </FilesMatch>
</IfModule>
